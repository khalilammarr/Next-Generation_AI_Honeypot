# Copy to .env and fill in GROQ_API_KEY. Never commit .env.
# Any OpenAI-compatible endpoint works; set GROQ_BASE_URL and GROQ_MODEL for it.

# --- LLM provider ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- Dashboard / Grafana exposure ---
# Host interface the dashboard (8080) and Grafana (3000) are published on.
# Keep 127.0.0.1 unless you put authentication in front of them.
DASHBOARD_BIND=127.0.0.1
GRAFANA_ADMIN_PASSWORD=change-me

# --- HTTP honeypot tuning ---
LLM_TIMEOUT_SECONDS=4.0
LLM_MAX_TOKENS=750
THINKING_ENABLED=false
LLM_CONCURRENCY=20
MAX_CACHE_ITEMS=5000
MAX_RESPONSE_CHARS=15000
FAST_SCANNER_MODE=false
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RESPONSE_CACHE_TTL_SECONDS=300
METRICS_LOG_EVERY=50
