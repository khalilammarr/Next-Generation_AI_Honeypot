# --- NVIDIA API ---
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Models ---
NVIDIA_MODEL_PRIMARY=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_SECONDARY=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_SSH=llama-3.1-8b-instant

# --- Performance ---
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_TOKENS=1024
THINKING_ENABLED=false
LLM_CONCURRENCY=20
MAX_CACHE_ITEMS=5000
MAX_RESPONSE_CHARS=15000
FAST_SCANNER_MODE=false
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RESPONSE_CACHE_TTL_SECONDS=300
METRICS_LOG_EVERY=50

GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.1-8b-instant
